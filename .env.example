# Copy to .env before running the README commands. These defaults run the assessment.
# Keep values unquoted: Compose and Spring both read this file.

# PostgreSQL: Compose creates this database/user on the first startup.
DB_NAME=card_disputes
DB_USERNAME=card_disputes
DB_PASSWORD=postgres

# Maven/IDE database connection. Compose overrides this with the database service hostname.
DB_URL=jdbc:postgresql://localhost:5432/${DB_NAME}

# Hosted Auth0 tenant and API audience; no client secret is needed by this resource server.
AUTH0_ISSUER_URI=https://dev-1fnyw5sg2ehum1ph.us.auth0.com/
AUTH0_AUDIENCE=https://api.carddisputeportal.local

# Flyway demo-data initialization only: link existing Auth0 users to seeded customers.
# Requests use validated JWTs and persisted database mappings, not these variables.
# Shannon Weir (shannonweir@capitecbank.co.za)
AUTH0_DEMO_SUBJECT=auth0|6acc0b351f3fb75f306214bb
# Alex Morgan (alexmorgan@capitecbank.co.za)
AUTH0_SECOND_DEMO_SUBJECT=auth0|6acc0d0b3eaa494f24fbd942

# Browser origins permitted to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Frontend Auth0 client/redirect settings live in the separate portal's environment files.
# Application defaults (ports, upload limits, logging, etc.) remain in application.yml/compose.yaml.
